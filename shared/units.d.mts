export type Lesson = { id: string; track: 'core' | 'closure'; icon: string; title: string; short: string; ref: string; outcomes: string[] };
export type Unit = Lesson;
export type Level = 'not-started' | 'developing' | 'struggling' | 'secure';
export type Ref = { book: string; section?: string; chapter?: string; pages?: string; slides: string };
export type Rank = { n: number; name: string; min: number; icon: string };
export const MASTERY_THRESHOLD: number;
export const OUTCOMES: Record<string, string>;
export const REFS: Record<string, Ref>;
export function cite(ref: string | Ref): string;
export const LESSONS: Lesson[];
export const UNITS: Lesson[];
export const CORE: Lesson[];
export const CLOSURE: Lesson[];
export function unitById(id: string): Lesson | undefined;
export const LEVELS: Rank[];
export const CLOSURE_THRESHOLD: number;
export function levelFor(points: number): Rank & { next: Rank | null; toNext: number; progress: number };
export const POINTS: { question: number[]; lesson: number; problem: number; problemAfterSolution: number };
export const TIERS_BY_LEVEL: Record<number, number[]>;
export function masteryLevel(attempts: { score: number; misconceptions?: string[] }[]): Level;
