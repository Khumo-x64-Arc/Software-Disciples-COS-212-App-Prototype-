export type Vertex = { id: string; x: number; y: number };
export type GEdge = { id: string; from: string; to: string; weight: number };
export type Graph = {
  directed: boolean;
  weighted: boolean;
  allowLoops: boolean;
  allowMulti: boolean;
  vertices: Vertex[];
  edges: GEdge[];
  nextEdge: number;
};
export type Props = {
  vertices: number; edges: number; directed: boolean; weighted: boolean;
  kind: 'simple graph' | 'multigraph' | 'pseudograph';
  loops: boolean; parallel: boolean; complete: boolean;
  connectivity: 'empty' | 'connected' | 'unconnected' | 'strongly connected' | 'weakly connected';
  cyclic: boolean; isTree: boolean; isolated: string[];
  deg: Record<string, number>; indeg: Record<string, number>; outdeg: Record<string, number>;
  degreeSum: number; knEdges: number;
};
export type TraversalStep = { note: string; current: string | null; edge: [string, string] | null; tone: 'tree' | 'skip'; reached: string[]; frontier: string[] };
export type WarshallStep = { k: number | null | 'done'; matrix: number[][]; changed: { i: number; j: number }[]; note: string };

export const MAX_VERTICES: number;
export const CANVAS: { width: number; height: number; radius: number };
export const LABELS: string;
export function emptyGraph(opts?: Partial<Graph>): Graph;
export function ids(g: Graph): string[];
export function nextLabel(g: Graph): string | null;
export function addVertex(g: Graph, x?: number, y?: number): { graph: Graph; id: string | null; reason?: string };
export function moveVertex(g: Graph, id: string, x: number, y: number): Graph;
export function removeVertex(g: Graph, id: string): Graph;
export function addEdge(g: Graph, from: string, to: string, weight?: number): { graph: Graph; ok: boolean; reason?: string; updated?: boolean; edge?: GEdge };
export function removeEdge(g: Graph, edgeId: string): Graph;
export function setWeight(g: Graph, edgeId: string, weight: number): Graph;
export function hasEdge(g: Graph, u: string, v: string): boolean;
export function neighbours(g: Graph, u: string): string[];
export function degrees(g: Graph): { deg: Record<string, number>; indeg: Record<string, number>; outdeg: Record<string, number> };
export function adjacencyMatrix(g: Graph, mode?: 'count' | 'weight'): number[][];
export function booleanMatrix(g: Graph): number[][];
export function adjacencyList(g: Graph): { id: string; list: { to: string; weight: number; edgeId: string }[] }[];
export function starForward(g: Graph): { start: number[]; neighbours: string[] };
export function incidenceMatrix(g: Graph): { rows: string[]; cols: string[]; cells: number[][] };
export function edgeListText(g: Graph): string;
export function reachableFrom(g: Graph, s: string): Set<string>;
export function properties(g: Graph): Props;
export function typeSentence(p: Props): string;
export function dfsTrace(g: Graph, s: string): { steps: TraversalStep[]; order: string[] };
export function bfsTrace(g: Graph, s: string): { steps: TraversalStep[]; order: string[] };
export function closureByDFS(g: Graph): number[][];
export function warshall(adj: number[][]): number[][];
export function warshallKInnermost(adj: number[][]): number[][];
export function warshallTrace(g: Graph): WarshallStep[];
export function closureAddedPairs(g: Graph): [string, string][];
export function exportText(g: Graph): string;
export function parseText(text: string, opts?: Partial<Graph>): Graph;
export function matrixText(r: number[][]): string;
export function rng(seed: number): () => number;
export function circleLayout(n: number): { x: number; y: number }[];
export function randomGraph(o: { n: number; density?: number; directed?: boolean; loops?: boolean; seed?: number }): Graph;
export function randomAdjacency(n: number, density: number, seed?: number): { matrix: number[][]; lists: number[][] };
export function closureFromLists(lists: number[][]): Uint8Array[];
export function closureFromMatrixDFS(m: number[][]): Uint8Array[];
